><sort/><column_widths><column index="1" value="32"/><column index="2" value="88"/><column index="3" value="70"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="loai_dich_vu" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="32"/><column index="2" value="85"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="quan_huyen" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="83"/><column index="2" value="59"/><column index="3" value="117"/><column index="4" value="39"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="tinh_thanh" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="32"/><column index="2" value="65"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="default*">-- TẠO DATABASE MỚI HOÀN TOÀN (chạy 1 lần là xong sườn)
PRAGMA foreign_keys = ON;

-- Xóa hết bảng cũ (nếu có)
DROP TABLE IF EXISTS lich_su_truy_cap;
DROP TABLE IF EXISTS dia_diem;
DROP TABLE IF EXISTS quan_huyen;
DROP TABLE IF EXISTS tinh_thanh;
DROP TABLE IF EXISTS loai_dich_vu;

-- 1. Tỉnh/Thành phố trực thuộc TW
CREATE TABLE tinh_thanh (
    id        INTEGER PRIMARY KEY,      -- 1=Hà Nội, 2=TP.HCM, 3=Đà Nẵng...
    ten_tinh  TEXT NOT NULL UNIQUE
);

-- 2. Quận/Huyện/Thành phố thuộc tỉnh
CREATE TABLE quan_huyen (
    id         INTEGER PRIMARY KEY,      -- 101-199=Hà Nội, 201-299=TP.HCM...
    tinh_id    INTEGER NOT NULL,
    ten_quan   TEXT NOT NULL,
    loai       TEXT DEFAULT 'Quận',     -- Quận / Huyện / Thành phố / Thị xã
    FOREIGN KEY (tinh_id) REFERENCES tinh_thanh(id) ON DELETE CASCADE,
    UNIQUE(tinh_id, ten_quan)
);

-- 3. Loại dịch vụ (chỉ 5 loại chính + hành chính)
CREATE TABLE loai_dich_vu (
    id        INTEGER PRIMARY KEY,
    ten_loai  TEXT NOT NULL UNIQUE
);

INSERT INTO loai_dich_vu (id, ten_loai) VALUES
(1, 'du_lich'),      -- Điểm tham quan, di tích, công viên...
(2, 'khach_san'),    -- Khách sạn, resort, homestay
(3, 'nha_hang'),     -- Nhà hàng, quán ăn
(4, 'vui_choi'),     -- Công viên giải trí, rạp phim, karaoke...
(5, 'hanh_chinh');   -- Công an, UBND, đại sứ quán, bệnh viện công...

-- 4. Địa điểm (bảng chính)
CREATE TABLE dia_diem (
    id              INTEGER PRIMARY KEY,
    quan_huyen_id   INTEGER NOT NULL,
    loai_dich_vu_id INTEGER NOT NULL,
    ten_dia_diem    TEXT    NOT NULL,
    dia_chi         TEXT,
    dien_thoai      TEXT,
    rate            REAL    DEFAULT 0 CHECK(rate BETWEEN 0 AND 5),
    so_danh_gia     INTEGER DEFAULT 0,
    gia_trung_binh   TEXT,          -- ví dụ: &quot;Miễn phí&quot;, &quot;100-300k&quot;, &quot;2-5tr&quot;
    gio_mo_cua       TEXT,
    FOREIGN KEY (quan_huyen_id)   REFERENCES quan_huyen(id)   ON DELETE CASCADE,
    FOREIGN KEY (loai_dich_vu_id) REFERENCES loai_dich_vu(id) ON DELETE CASCADE
);

-- 5. Lịch sử truy cập (để thống kê lượt xem)
CREATE TABLE lich_su_truy_cap (
    id           INTEGER PRIMARY KEY,
    dia_diem_id  INTEGER NOT NULL,
    thoi_gian   TEXT DEFAULT (datetime('now','localtime')),
    FOREIGN KEY (dia_diem_id) REFERENCES dia_diem(id) ON DELETE CASCADE
);

-- KIỂM TRA
SELECT 'SƯỜN DATABASE MỚI HOÀN THÀNH – SẴN SÀNG THÊM DỮ LIỆU!' AS STATUS;</sql><sql name="importHN*">-- ================== [TỈNH BẠN MUỐN] – 10 ĐIỂM MỚI NHẤT 2025 ==================
-- Ví dụ dưới đây là HÀ NỘI (bạn chỉ việc đổi tên tỉnh + ID quận khi dùng cho tỉnh khác)

-- 1. Đảm bảo tỉnh + quận (chạy lại cũng an toàn)
INSERT OR IGNORE INTO tinh_thanh (id, ten_tinh) VALUES (1, 'Hà Nội');
INSERT OR IGNORE INTO quan_huyen (id, tinh_id, ten_quan, loai) VALUES
(101,1,'Quận Hoàn Kiếm','Quận'),(102,1,'Quận Ba Đình','Quận'),
(103,1,'Quận Tây Hồ','Quận'),(104,1,'Quận Đống Đa','Quận'),
(105,1,'Quận Cầu Giấy','Quận');

-- 2. XÓA sạch dữ liệu cũ của Hà Nội
DELETE FROM dia_diem WHERE quan_huyen_id BETWEEN 101 AND 105;

-- 3. Thêm mới 10 điểm – rate 3.0→4.5 + lượt xem + số điện thoại ngẫu nhiên đẹp
INSERT INTO dia_diem (quan_huyen_id, loai_dich_vu_id, ten_dia_diem, dia_chi, dien_thoai,       rate, so_danh_gia,   gia_trung_binh, gio_mo_cua) VALUES

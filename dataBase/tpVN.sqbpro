-- 4. Kiểm tra
SELECT 'HOÀN THÀNH – 10 ĐIỂM MỚI + SỐ ĐIỆN THOẠI!' AS STATUS,
       COUNT(*) AS SO_DIEM 
FROM dia_diem 
WHERE quan_huyen_id BETWEEN 101 AND 105;</sql><sql name="importCT*">-- ================== CẦN THƠ – 10 ĐIỂM MỚI NHẤT 2025 ==================

